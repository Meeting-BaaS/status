# Authentication app URL
NEXT_PUBLIC_AUTH_APP_URL=http://localhost:3001
# Auth cookie name created by the auth app
AUTH_COOKIE_NAME=meeting-baas.session_token

# Meeting BaaS environment prefix for app URLs. For lower environments, it would be something like pre-prod-
# It should be empty for prod.
NEXT_PUBLIC_ENVIRONMENT=pre-prod-

# Meeting BaaS base domain for external app URLs (Without protocol or leading dot)
NEXT_PUBLIC_BASE_DOMAIN=meetingbaas.com

# Meeting BaaS API server base URL (v2 api-server).
# The app proxies /api/baas/:path* to ${API_SERVER_BASEURL}/:path*, calling
# the public analytics endpoint at /public/bots/analytics on the v2 server.
# e.g. https://api.meetingbaas.com
API_SERVER_BASEURL=

# Support email, to be displayed on error boundary page, e.g. support@meetingbaas.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@meetingbaas.com
